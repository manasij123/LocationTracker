# Leave empty for same-origin deploys or local dev (Vite proxies /api to the backend).
# Set this only when the frontend and backend are hosted on different domains, e.g.:
# VITE_API_BASE_URL=https://spotshare-api.onrender.com
VITE_API_BASE_URL=

# Google Maps JavaScript API key (browser-side — must be restricted to this app's domain(s)
# via HTTP referrer restrictions in Google Cloud, and to the Maps JavaScript API only).
# This key is publicly visible in the built frontend bundle by design; the referrer
# restriction is what keeps it from being usable on other sites.
VITE_GOOGLE_MAPS_API_KEY=
