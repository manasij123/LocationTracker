# If hosting the database on Neon, use the "Pooled connection" string from Neon's dashboard
# (its host contains "-pooler") rather than the direct one — Neon suspends its compute after a
# few minutes idle either way, but the pooler reconnects faster and handles bursts of requests
# right after a cold start (e.g. Render's free tier waking up) much better than a direct connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotshare"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Geocoding / place search provider — one of:
#   mock      offline built-in dataset, no key or network access required (default)
#   nominatim live OpenStreetMap search, free, no key required
#   google    Google Places API (New) Text Search — best result quality/coverage,
#             requires GEOCODING_API_KEY (a Places API (New)-restricted Google Cloud key)
MAP_PROVIDER=mock
GEOCODING_API_KEY=

# Demo user used until real auth is implemented
DEMO_USER_EMAIL=demo@spotshare.app
DEMO_USER_NAME="Demo User"

# How long a "My Current Location" live share's raw GPS trail (LiveTrackPoint rows) is kept
# before being purged — it's meant as a safety record, so it deliberately outlives the share's
# own 12-hour safety-net expiry, but isn't kept forever either. Default: 60 days.
LIVE_TRACK_RETENTION_DAYS=60

# How long Activity feed entries (ActivityEvent rows — share created, link opened, expired,
# revoked, location updated) are kept before being purged. It's just a rolling recent-activity
# log, not a record anything else depends on, so it doesn't need to be kept nearly as long as a
# live share's GPS trail. Default: 7 days.
ACTIVITY_RETENTION_DAYS=7
