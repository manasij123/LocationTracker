DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spotshare"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Geocoding / place search provider
# Set to "nominatim" to use the live OpenStreetMap Nominatim API, or "mock" to use
# the built-in offline provider (no API key or network access required).
MAP_PROVIDER=mock
GEOCODING_API_KEY=
MAP_PROVIDER_API_KEY=

# Demo user used until real auth is implemented
DEMO_USER_EMAIL=demo@spotshare.app
DEMO_USER_NAME="Demo User"
